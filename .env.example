# Modèle de fichier .env — GATE SEC-1.
#
# Copier ce fichier vers `.env` (jamais suivi par Git — voir .gitignore) et
# renseigner les valeurs réelles localement, ou via les variables
# d'environnement Vercel (Project Settings -> Environment Variables).
#
# Aucune valeur ci-dessous n'est réelle. Ne jamais committer un `.env`
# contenant de vraies valeurs.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder
GEMINI_API_KEY=your-gemini-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-ga-measurement-id-placeholder
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-placeholder
PERPLEXITY_API_KEY=your-perplexity-api-key-placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-placeholder
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_APP_NAME=METALTRACE
NEXT_PUBLIC_APP_URL=https://example.com
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-placeholder
